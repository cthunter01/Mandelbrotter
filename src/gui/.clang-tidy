# The wxWidgets layer: parent-owned widgets are created with `new`, wx headers are umbrella headers, and wx's
# flags are plain enums combined with | (wxLEFT | wxRIGHT | wxTOP), so three checks from the project config do
# not fit here.
InheritParentConfig: true
Checks: >
  -cppcoreguidelines-owning-memory,
  -misc-include-cleaner,
  -bugprone-signed-bitwise
